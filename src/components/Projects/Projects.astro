---
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import { getLangFromUrl } from "../../i18n/utils";
import { translations } from "../../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = translations[lang].projects;

// Fetch all projects
const allProjects = await getCollection("projects");
const projectsMap = new Map<string, CollectionEntry<"projects">>();

// 1. Populate with default language (es) as fallback
allProjects
  .filter((p) => p.id.startsWith("es/"))
  .forEach((p) => {
    const baseId = p.id.split("/")[1];
    projectsMap.set(baseId, p);
  });

// 2. If current language is different, overwrite with translated versions where available
if (lang !== "es") {
  allProjects
    .filter((p) => p.id.startsWith(`${lang}/`))
    .forEach((p) => {
      const baseId = p.id.split("/")[1];
      projectsMap.set(baseId, p);
    });
}

const projects = Array.from(projectsMap.values());

// Sort by date (newest first)
projects.sort(
  (a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) =>
    b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<section id="projects" class="py-20 relative">
  <div class="container mx-auto px-6">
    <h2 class="text-4xl md:text-5xl font-bold mb-16 text-center">
      <span
        class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600"
        >{t.title}</span
      >
    </h2>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        projects.map((project) => (
          <div class="group relative">
            <div class="absolute inset-0 bg-gradient-to-r from-blue-500 to-purple-600 rounded-2xl blur-xl opacity-50 group-hover:opacity-75 transition-opacity" />
            <div class="relative glass rounded-2xl overflow-hidden card-hover">
              <div class="h-48 bg-gradient-to-br from-blue-600/20 to-purple-600/20 relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
                <Image
                  src={project.data.image}
                  width="1600"
                  height="900"
                  loading="lazy"
                  alt={project.data.title}
                  class="w-full h-full object-cover opacity-50"
                />
              </div>
              <div class="p-6">
                <h3 class="text-2xl font-bold mb-2 text-white">
                  {project.data.title}
                </h3>
                <p class="text-gray-400 mb-4">{project.data.description}</p>
                <div class="flex flex-wrap gap-2 mb-4">
                  {project.data.tags.map((tag) => (
                    <span class="px-3 py-1 bg-blue-500/20 text-blue-400 rounded-full text-sm">
                      {tag}
                    </span>
                  ))}
                </div>
                <div class="flex gap-4">
                  {project.data.link && (
                    <a
                      href={project.data.link}
                      target="_blank"
                      rel="noopener"
                      class="text-blue-400 hover:text-blue-300 transition-colors"
                      title={t.preview}
                    >
                      <svg
                        class="w-6 h-6"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <title>{t.preview}</title>
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                      </svg>
                    </a>
                  )}
                  {project.data.github && (
                    <a
                      href={project.data.github}
                      target="_blank"
                      rel="noopener"
                      class="text-gray-400 hover:text-white transition-colors"
                      title={t.code}
                    >
                      <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <title>{t.code}</title>
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <div class="flex flex-col items-center mt-12">
      <button
        id="show-more-projects"
        class="px-8 py-4 glass rounded-full font-semibold text-lg border border-purple-500 hover:bg-blue-500/20 transition-all"
        type="button"
      >
        {t.viewMore}
      </button>
      <span
        id="more-projects-message"
        class="mt-4 text-blue-400 font-medium hidden">{t.moreComing}</span
      >
    </div>
    <script>
      const btn = document.getElementById("show-more-projects");
      const msg = document.getElementById("more-projects-message");
      if (btn && msg) {
        btn.addEventListener("click", () => {
          msg.classList.remove("hidden");
        });
      }
    </script>
  </div>
</section>
