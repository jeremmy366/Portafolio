---
import { getLangFromUrl } from "../../i18n/utils";
import { translations } from "../../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = translations[lang].about;
---

<section id="about" class="py-20 relative">
  <div class="container mx-auto px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-4xl md:text-5xl font-bold mb-16 text-center scroll-title">
        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-600"
          >{t.title}</span
        >
      </h2>

      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <div class="glass p-6 rounded-2xl card-hover scroll-fade-left stagger-1">
            <h3 class="text-xl font-semibold text-blue-400 mb-3">{t.role1}</h3>
            <p class="text-gray-300 leading-relaxed">{t.desc1}</p>
          </div>

          <div class="glass p-6 rounded-2xl card-hover scroll-fade-left stagger-2">
            <h3 class="text-xl font-semibold text-purple-400 mb-3">
              {t.role2}
            </h3>
            <p class="text-gray-300 leading-relaxed">{t.desc2}</p>
          </div>

          <div class="glass p-6 rounded-2xl card-hover scroll-fade-left stagger-3">
            <h3 class="text-xl font-semibold text-cyan-400 mb-3">{t.role3}</h3>
            <p class="text-gray-300 leading-relaxed">{t.desc3}</p>
          </div>
        </div>

        <div class="relative scroll-fade-right stagger-2">
          <div class="glass p-8 rounded-2xl">
            <h3 class="text-xl font-semibold text-white mb-5">{t.evidenceTitle}</h3>
            <dl class="space-y-5">
              <div><dt class="text-blue-400 font-semibold">{t.frontend}</dt><dd class="text-sm text-gray-300 mt-1">{t.frontendEvidence}</dd></div>
              <div><dt class="text-purple-400 font-semibold">{t.backend}</dt><dd class="text-sm text-gray-300 mt-1">{t.backendEvidence}</dd></div>
              <div><dt class="text-green-400 font-semibold">{t.db}</dt><dd class="text-sm text-gray-300 mt-1">{t.dbEvidence}</dd></div>
              <div><dt class="text-orange-400 font-semibold">{t.devops}</dt><dd class="text-sm text-gray-300 mt-1">{t.devopsEvidence}</dd></div>
            </dl>
          </div>

          <!-- Decoración flotante -->
          <div
            class="absolute -top-4 -right-4 w-20 h-20 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full blur-xl opacity-50"
          >
          </div>
          <div
            class="absolute -bottom-4 -left-4 w-16 h-16 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-full blur-xl opacity-50"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
