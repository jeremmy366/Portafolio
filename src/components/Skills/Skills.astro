---
import { Image } from 'astro:assets';
---

<section id="skills" class="py-20 relative">
  <div class="container mx-auto px-6">
    <h2 class="text-4xl md:text-5xl font-bold mb-16 text-center scroll-title">
      <span
        class="text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-blue-600"
        >Stack Tecnológico</span
      >
    </h2>

    <!-- Frontend -->
    <div class="skills-category mb-12 scroll-fade-up">
      <div class="category-header mb-6 flex items-center gap-3">
        <span class="category-icon">
          <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
        </span>
        <h3 class="text-xl md:text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">
          Frontend
        </h3>
        <div class="category-line flex-1 h-px bg-gradient-to-r from-cyan-500/40 to-transparent"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-1">
          <Image
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg"
            width="1600"
            height="900"
            alt="React"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform"
            loading="lazy"
          />
          <h4 class="font-semibold text-blue-400">React</h4>
        </div>
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-2">
          <Image
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/angularjs/angularjs-original.svg"
            width="1600"
            height="900"
            alt="Angular"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform"
            loading="lazy"
          />
          <h4 class="font-semibold text-red-400">Angular</h4>
        </div>
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-3">
          <Image
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nextjs/nextjs-original.svg"
            width="1600"
            height="900"
            alt="Next.js"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform bg-white rounded-full p-1"
            loading="lazy"
          />
          <h4 class="font-semibold text-yellow-400">Next.js</h4>
        </div>
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-4">
          <Image
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/flutter/flutter-original.svg"
            width="1600"
            height="900"
            alt="Flutter"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform"
            loading="lazy"
          />
          <h4 class="font-semibold text-sky-400">Flutter</h4>
        </div>
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-5">
          <Image
            src="https://upload.wikimedia.org/wikipedia/commons/thumb/archive/d/d5/20230715030041%21Tailwind_CSS_Logo.svg/120px-Tailwind_CSS_Logo.svg.png"
            width="1600"
            height="900"
            alt="Tailwind"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform"
            loading="lazy"
          />
          <h4 class="font-semibold text-cyan-400">Tailwind</h4>
        </div>
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-6">
          <Image
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg"
            alt="TypeScript"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform"
            width="1600"
            height="900"
            loading="lazy"
          />
          <h4 class="font-semibold text-blue-500">TypeScript</h4>
        </div>
      </div>
    </div>

    <!-- Backend -->
    <div class="skills-category mb-12 scroll-fade-up">
      <div class="category-header mb-6 flex items-center gap-3">
        <span class="category-icon">
          <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.573-1.066z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </span>
        <h3 class="text-xl md:text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-500">
          Backend
        </h3>
        <div class="category-line flex-1 h-px bg-gradient-to-r from-green-500/40 to-transparent"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-1">
          <Image
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg"
            alt="Node.js"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform"
            width="1600"
            height="900"
            loading="lazy"
          />
          <h4 class="font-semibold text-green-500">Node.js</h4>
        </div>
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-2">
          <Image
            src="https://upload.wikimedia.org/wikipedia/commons/a/a8/NestJS.svg"
            width="1600"
            height="900"
            loading="lazy"
            alt="NestJS"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform"
          />
          <h4 class="font-semibold text-red-500">NestJS</h4>
        </div>
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-3">
          <Image
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/java/java-original.svg"
            alt="Java"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform"
            width="1600"
            height="900"
            loading="lazy"
          />
          <h4 class="font-semibold text-orange-400">Java</h4>
        </div>
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-4">
          <Image
            src="https://upload.wikimedia.org/wikipedia/commons/7/79/Spring_Boot.svg"
            alt="Spring Boot"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform"
            width="1600"
            height="900"
            loading="lazy"
          />
          <h4 class="font-semibold text-green-600">Spring Boot</h4>
        </div>
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-5">
          <Image
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg"
            alt="Python"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform"
            width="1600"
            height="900"
            loading="lazy"
          />
          <h4 class="font-semibold text-yellow-500">Python</h4>
        </div>
      </div>
    </div>

    <!-- Bases de Datos -->
    <div class="skills-category mb-12 scroll-fade-up">
      <div class="category-header mb-6 flex items-center gap-3">
        <span class="category-icon">
          <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
          </svg>
        </span>
        <h3 class="text-xl md:text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-500">
          Bases de Datos
        </h3>
        <div class="category-line flex-1 h-px bg-gradient-to-r from-purple-500/40 to-transparent"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-1">
          <Image
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg"
            alt="PostgreSQL"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform"
            width="1600"
            height="900"
            loading="lazy"
          />
          <h4 class="font-semibold text-blue-600">PostgreSQL</h4>
        </div>
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-2">
          <Image
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mysql/mysql-original.svg"
            alt="MySQL"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform"
            width="1600"
            height="900"
            loading="lazy"
          />
          <h4 class="font-semibold text-blue-400">MySQL</h4>
        </div>
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-3">
          <Image
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mongodb/mongodb-original.svg"
            alt="MongoDB"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform"
            width="1600"
            height="900"
            loading="lazy"
          />
          <h4 class="font-semibold text-green-500">MongoDB</h4>
        </div>
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-4">
          <Image
            src="https://firebase.google.com/static/images/brand-guidelines/logo-logomark.png?hl=es-419"
            alt="Firebase"
            class="w-12 h-12 mx-auto mb-2 bg-white p-1 rounded group-hover:scale-110 transition-transform"
            width="1600"
            height="900"
            loading="lazy"
          />
          <h4 class="font-semibold text-orange-500">Firebase</h4>
        </div>
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-5">
          <Image
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/oracle/oracle-original.svg"
            alt="Oracle"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform"
            width="1600"
            height="900"
            loading="lazy"
          />
          <h4 class="font-semibold text-red-400">Oracle</h4>
        </div>
      </div>
    </div>

    <!-- DevOps & Cloud -->
    <div class="skills-category mb-12 scroll-fade-up">
      <div class="category-header mb-6 flex items-center gap-3">
        <span class="category-icon">
          <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
          </svg>
        </span>
        <h3 class="text-xl md:text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-amber-500">
          DevOps & Cloud
        </h3>
        <div class="category-line flex-1 h-px bg-gradient-to-r from-orange-500/40 to-transparent"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-1">
          <Image
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg"
            alt="Docker"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform"
            width="1600"
            height="900"
            loading="lazy"
          />
          <h4 class="font-semibold text-blue-500">Docker</h4>
        </div>
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-2">
          <Image
            src="https://a0.awsstatic.com/libra-css/images/logos/aws_logo_smile_1200x630.png"
            alt="AWS"
            class="w-12 h-12 mx-auto mb-2 rounded group-hover:scale-110 transition-transform bg-white p-1"
            width="1600"
            height="900"
            loading="lazy"
          />
          <h4 class="font-semibold text-orange-400">AWS</h4>
        </div>
      </div>
    </div>

    <!-- Herramientas -->
    <div class="skills-category scroll-fade-up">
      <div class="category-header mb-6 flex items-center gap-3">
        <span class="category-icon">
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.573-1.066z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </span>
        <h3 class="text-xl md:text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-gray-400 to-slate-500">
          Herramientas
        </h3>
        <div class="category-line flex-1 h-px bg-gradient-to-r from-gray-500/40 to-transparent"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-1">
          <Image
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/git/git-original.svg"
            alt="Git"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform"
            width="1600"
            height="900"
            loading="lazy"
          />
          <h4 class="font-semibold text-gray-400">Git</h4>
        </div>
        <div class="skill-card glass p-6 rounded-xl text-center card-hover group scroll-scale stagger-2">
          <Image
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linux/linux-original.svg"
            alt="Linux"
            class="w-12 h-12 mx-auto mb-2 group-hover:scale-110 transition-transform"
            width="1600"
            height="900"
            loading="lazy"
          />
          <h4 class="font-semibold text-yellow-600">Linux</h4>
        </div>
      </div>
    </div>
  </div>
</section>
